+// Native embedder tab state, separate from concealed physical Browser widgets.
+#ifndef CHROME_BROWSER_EXTENSIONS_EXTERNAL_TAB_MODEL_H_
+#define CHROME_BROWSER_EXTENSIONS_EXTERNAL_TAB_MODEL_H_
+#include <algorithm>
+#include <memory>
+#include <utility>
+#include <vector>
+#include "base/supports_user_data.h"
+#include "base/memory/weak_ptr.h"
+#include "content/public/browser/web_contents.h"
+
+namespace extensions {
+// The exact synchronous Chrome API creation operation, captured before
+// Navigate creates/attaches a different native Browser. Nested operations
+// restore the previous operation; no last-active-tab or timing inference.
+class ScopedExternalTabCreation {
+ public:
+  ScopedExternalTabCreation(content::WebContents* owner,
+                            content::WebContents* opener, bool active, int index)
+      : previous_(current_), owner_(owner ? owner->GetWeakPtr()
+                                        : base::WeakPtr<content::WebContents>()),
+        opener_(opener ? opener->GetWeakPtr() : base::WeakPtr<content::WebContents>()),
+        active_(active), index_(index) { current_ = this; }
+  ~ScopedExternalTabCreation() { current_ = previous_; }
+  ScopedExternalTabCreation(const ScopedExternalTabCreation&) = delete;
+  ScopedExternalTabCreation& operator=(const ScopedExternalTabCreation&) = delete;
+  static const ScopedExternalTabCreation* Current() { return current_; }
+  content::WebContents* owner() const { return owner_.get(); }
+  content::WebContents* opener() const { return opener_.get(); }
+  bool active() const { return active_; }
+  int index() const { return index_; }
+ private:
+  inline static thread_local ScopedExternalTabCreation* current_ = nullptr;
+  ScopedExternalTabCreation* previous_;
+  base::WeakPtr<content::WebContents> owner_, opener_;
+  bool active_;
+  int index_;
+};
+// UI sequence only. Chrome owns all WebContents and their real session IDs.
+// A group only retains weak identities, never a page or a physical window.
+class ExternalTabModel : public base::SupportsUserData::Data {
+ public:
+  static ExternalTabModel* Get(const content::WebContents* contents) {
+    return contents && !contents->IsBeingDestroyed()
+        ? static_cast<ExternalTabModel*>(contents->GetUserData(&kKey)) : nullptr;
+  }
+  static bool Bind(content::WebContents* contents,
+                   content::WebContents* requested_owner,
+                   content::WebContents* opener,
+                   int native_window_id, bool active, int index) {
+    if (!contents || !requested_owner || contents->IsBeingDestroyed() ||
+        requested_owner->IsBeingDestroyed() || native_window_id < 0 ||
+        contents->GetBrowserContext() != requested_owner->GetBrowserContext() ||
+        (opener && (opener->IsBeingDestroyed() ||
+                    opener->GetBrowserContext() != contents->GetBrowserContext())))
+      return false;
+    auto* owner = Get(requested_owner);
+    if (!owner) {
+      auto group = std::make_shared<Group>();
+      group->window = native_window_id;
+      group->active = requested_owner->GetWeakPtr();
+      group->tabs.push_back(requested_owner->GetWeakPtr());
+      requested_owner->SetUserData(&kKey, std::unique_ptr<ExternalTabModel>(
+          new ExternalTabModel(requested_owner, group, nullptr)));
+      owner = Get(requested_owner);
+    }
+    auto group = owner->group_;
+    if (auto* current = Get(contents); current && current->group_ != group)
+      return false;  // Reparenting requires an explicit later model operation.
+    Compact(*group);
+    auto& tabs = group->tabs;
+    std::erase_if(tabs, [contents](const auto& tab) { return tab.get() == contents; });
+    const auto at = index < 0 ? tabs.size()
+                             : std::min(static_cast<size_t>(index), tabs.size());
+    tabs.insert(tabs.begin() + at, contents->GetWeakPtr());
+    if (active) group->active = contents->GetWeakPtr();
+    contents->SetUserData(&kKey, std::unique_ptr<ExternalTabModel>(
+        new ExternalTabModel(contents, std::move(group), opener)));
+    return true;
+  }
+  bool active() const { return contents_ && group_->active == contents_; }
+  int window() const { return group_->window; }
+  int index() const {
+    Compact(*group_);
+    for (size_t i = 0; i < group_->tabs.size(); ++i)
+      if (group_->tabs[i] == contents_) return static_cast<int>(i);
+    return -1;
+  }
+  content::WebContents* opener() const {
+    return opener_ && !opener_->IsBeingDestroyed() ? opener_.get() : nullptr;
+  }
+  bool Activate() {
+    if (!contents_ || contents_->IsBeingDestroyed()) return false;
+    Compact(*group_);
+    group_->active = contents_;
+    return true;
+  }
+ private:
+  struct Group {
+    int window = -1;
+    base::WeakPtr<content::WebContents> active;
+    std::vector<base::WeakPtr<content::WebContents>> tabs;
+  };
+  static void Compact(Group& group) {
+    std::erase_if(group.tabs, [](const auto& tab) {
+      return !tab || tab->IsBeingDestroyed();
+    });
+    if (group.active && group.active->IsBeingDestroyed()) group.active.reset();
+  }
+  ExternalTabModel(content::WebContents* contents, std::shared_ptr<Group> group,
+                   content::WebContents* opener)
+      : group_(std::move(group)), contents_(contents->GetWeakPtr()),
+        opener_(opener ? opener->GetWeakPtr() : base::WeakPtr<content::WebContents>()) {}
+  inline static const int kKey = 0;
+  std::shared_ptr<Group> group_;
+  base::WeakPtr<content::WebContents> contents_, opener_;
+};
+}  // namespace extensions
+#endif
