+// Embedder hooks, set by CEF on the UI thread before any browser exists. Null
+// hooks are no-ops, so ordinary builds keep Chrome's behavior.
+struct ExternalExtensionHooks {
+  // The action popup |popup| (with an ExternalActionOrigin) was shown in
+  // |widget|, or is being destroyed.
+  void (*popup_shown)(content::WebContents* popup, views::Widget* widget) =
+      nullptr;
+  void (*popup_closed)(content::WebContents* popup) = nullptr;
+  // chrome.tabs.create made |contents| with the requested foreground state,
+  // tab strip index (-1 default) and opener tab (may be null).
+  void (*tab_created)(content::WebContents* contents,
+                      content::WebContents* opener,
+                      bool active,
+                      int index,
+                      const std::string& extension_id) = nullptr;
+};
+inline ExternalExtensionHooks& GetExternalExtensionHooks() {
+  static ExternalExtensionHooks hooks;
+  return hooks;
+}
