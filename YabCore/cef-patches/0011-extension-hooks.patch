+namespace {
+// The CEF browser and display handler whose page owns |contents|.
+CefRefPtr<CefDisplayHandler> DisplayHandlerFor(
+    content::WebContents* contents,
+    CefRefPtr<CefBrowserHostBase>* browser) {
+  if (!CEF_API_IS_ADDED(CEF_EXPERIMENTAL) || !contents) return nullptr;
+  *browser = CefBrowserHostBase::GetBrowserForContents(contents);
+  auto client = *browser ? (*browser)->client() : nullptr;
+  return client ? client->GetDisplayHandler() : nullptr;
+}
+
+// Remembers the popup compositor so its frame callback can be removed.
+class ExternalPopup : public content::WebContentsUserData<ExternalPopup> {
+ public:
+  gfx::AcceleratedWidget accelerated = gfx::kNullAcceleratedWidget;
+  int window_number = 0;
+ private:
+  friend class content::WebContentsUserData<ExternalPopup>;
+  explicit ExternalPopup(content::WebContents* contents)
+      : content::WebContentsUserData<ExternalPopup>(*contents) {}
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+WEB_CONTENTS_USER_DATA_KEY_IMPL(ExternalPopup);
+
+void SendPopup(content::WebContents* popup, const char* state,
+               uint32_t context, const gfx::Size& pixels, float scale) {
+  auto* origin = extensions::ExternalActionOrigin::Get(popup);
+  auto* owner = origin ? origin->Owner(popup) : nullptr;
+  CefRefPtr<CefBrowserHostBase> browser;
+  auto handler = DisplayHandlerFor(owner, &browser);
+  if (!handler) return;
+  auto value = CefDictionaryValue::Create();
+  value->SetString("state", state);
+  value->SetString("extensionId", origin->extension_id());
+  value->SetString("token", origin->token().ToString());
+  auto* host = ExternalPopup::FromWebContents(popup);
+  value->SetInt("windowNumber", host ? host->window_number : 0);
+  if (context || std::string(state) == "frame") {
+    value->SetInt("contextId", static_cast<int>(context));
+    value->SetInt("pixelWidth", pixels.width());
+    value->SetInt("pixelHeight", pixels.height());
+    value->SetDouble("scale", scale);
+  }
+  handler->OnExtensionPopup(browser.get(), value);
+}
+
+void PopupFrame(base::WeakPtr<content::WebContents> popup, uint32_t context,
+                const gfx::Size& pixels, float scale) {
+  if (popup && !popup->IsBeingDestroyed())
+    SendPopup(popup.get(), "frame", context, pixels, scale);
+}
+
+void PopupShown(content::WebContents* popup, views::Widget* widget) {
+  if (!CEF_API_IS_ADDED(CEF_EXPERIMENTAL) || !popup || !widget) return;
+  auto* host = ExternalPopup::GetOrCreateForWebContents(popup);
+  NSWindow* window = widget->GetNativeWindow().GetNativeNSWindow();
+  host->window_number = window ? static_cast<int>(window.windowNumber) : 0;
+  if (auto* compositor = widget->GetCompositor()) {
+    host->accelerated = compositor->widget();
+    ui::AcceleratedWidgetMac::SetFrameCallback(
+        host->accelerated,
+        base::BindRepeating(&PopupFrame, popup->GetWeakPtr()));
+  }
+  SendPopup(popup, "shown", 0, gfx::Size(), 1.f);
+}
+
+void PopupClosed(content::WebContents* popup) {
+  if (!popup) return;
+  if (auto* host = ExternalPopup::FromWebContents(popup)) {
+    if (host->accelerated != gfx::kNullAcceleratedWidget) {
+      ui::AcceleratedWidgetMac::SetFrameCallback(host->accelerated, {});
+      host->accelerated = gfx::kNullAcceleratedWidget;
+    }
+  }
+  SendPopup(popup, "closed", 0, gfx::Size(), 1.f);
+}
+
+void TabCreated(content::WebContents* contents, content::WebContents* opener,
+                bool active, int index, const std::string& extension_id) {
+  CefRefPtr<CefBrowserHostBase> browser;
+  auto handler = DisplayHandlerFor(contents, &browser);
+  if (!handler) return;
+  auto opener_browser =
+      opener ? CefBrowserHostBase::GetBrowserForContents(opener) : nullptr;
+  auto value = CefDictionaryValue::Create();
+  value->SetBool("active", active);
+  value->SetInt("index", index);
+  value->SetInt("openerBrowserId",
+                opener_browser ? opener_browser->GetIdentifier() : 0);
+  value->SetString("extensionId", extension_id);
+  handler->OnExtensionTabCreated(browser.get(), value);
+}
+}  // namespace
+
+void InstallExtensionHooks() {
+  auto& hooks = extensions::GetExternalExtensionHooks();
+  hooks.popup_shown = &PopupShown;
+  hooks.popup_closed = &PopupClosed;
+  hooks.tab_created = &TabCreated;
+}
 
