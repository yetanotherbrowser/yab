+namespace {
+// viz keeps a single set of throttled frame sinks for the browser process and
+// each Throttle() replaces it, so every change sends all the slowed producer
+// compositors again. A closed producer's widget is gone: so is its entry.
+struct PacedFrames {
+  std::map<viz::FrameSinkId, base::WeakPtr<views::Widget>> roots;
+  base::TimeDelta interval;
+};
+PacedFrames& Paced() {
+  static base::NoDestructor<PacedFrames> paced;
+  return *paced;
+}
+}  // namespace
+
+bool CefBrowserHostBase::SetFrameInterval(int interval_ms) {
+  CEF_REQUIRE_UIT_RETURN(false);
+  if (interval_ms < 0 || interval_ms > 1000) {
+    return false;
+  }
+  auto web_contents = GetWebContents();
+  // The page's own frame sink is a child of its window's compositor
+  // (BrowserCompositorMac uses the parent layer's), and viz throttles a sink's
+  // descendants with it, including a renderer that replaces this one later.
+  auto* widget = web_contents ? views::Widget::GetTopLevelWidgetForNativeView(
+                                    web_contents->GetNativeView())
+                              : nullptr;
+  auto* compositor = widget ? widget->GetCompositor() : nullptr;
+  auto* manager = compositor && compositor->context_factory()
+                      ? compositor->context_factory()->GetHostFrameSinkManager()
+                      : nullptr;
+  if (!manager) {
+    return false;
+  }
+  auto& paced = Paced();
+  std::erase_if(paced.roots, [](const auto& root) { return !root.second; });
+  if (interval_ms > 0) {
+    paced.roots[compositor->frame_sink_id()] = widget->GetWeakPtr();
+    paced.interval = base::Milliseconds(interval_ms);
+  } else {
+    paced.roots.erase(compositor->frame_sink_id());
+  }
+  std::vector<viz::FrameSinkId> ids;
+  for (const auto& root : paced.roots) {
+    ids.push_back(root.first);
+  }
+  manager->Throttle(ids, paced.interval);
+  return true;
+}
